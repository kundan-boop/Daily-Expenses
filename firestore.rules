rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Schema Blueprint: BackupManifest
    function isValidBackupManifest(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.backupDate is string &&
             data.backupDate.size() >= 8 && data.backupDate.size() <= 20 &&
             data.backupDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.chunkCount is int &&
             data.chunkCount >= 1 && data.chunkCount <= 50 &&
             data.totalBytes is int &&
             data.totalBytes >= 1 && data.totalBytes <= 35000000 &&
             data.verified is bool &&
             data.customerCount is int &&
             data.customerCount >= 0 && data.customerCount <= 100000 &&
             data.transactionCount is int &&
             data.transactionCount >= 0 && data.transactionCount <= 500000 &&
             data.hasUserProfile is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    // Schema Blueprint: BackupChunk
    function isValidBackupChunk(data, userId, backupId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.backupId is string &&
             data.backupId == backupId &&
             isValidId(data.backupId) &&
             data.chunkIndex is int &&
             data.chunkIndex >= 0 && data.chunkIndex < 50 &&
             data.payload is string &&
             data.payload.size() >= 1 && data.payload.size() <= 800000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/backups/{backupId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(backupId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(backupId) &&
                       incoming().keys().hasAll([
                         'userId', 'backupDate', 'chunkCount', 'totalBytes',
                         'verified', 'customerCount', 'transactionCount',
                         'hasUserProfile', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'backupDate', 'chunkCount', 'totalBytes',
                         'verified', 'customerCount', 'transactionCount',
                         'hasUserProfile', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidBackupManifest(incoming(), userId);

      // Action-based Update: overwrite snapshot metadata or finalize verification
      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(backupId) &&
                       isValidBackupManifest(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().backupDate == existing().backupDate &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (
                           incoming().verified == false &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'chunkCount', 'totalBytes', 'verified',
                             'customerCount', 'transactionCount', 'hasUserProfile', 'updatedAt'
                           ])
                         ) ||
                         (
                           incoming().verified == true &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['verified', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(backupId);

      match /chunks/{chunkId} {
        allow get: if isSignedIn() &&
                      request.auth.uid == userId &&
                      isValidId(backupId) &&
                      isValidId(chunkId);
        allow list: if isSignedIn() && request.auth.uid == userId;

        // Parent Gate verifies parent BackupManifest exists and belongs to the signed-in owner
        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(backupId) &&
                         isValidId(chunkId) &&
                         incoming().keys().hasAll([
                           'userId', 'backupId', 'chunkIndex', 'payload', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'backupId', 'chunkIndex', 'payload', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidBackupChunk(incoming(), userId, backupId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/backups/$(backupId)) &&
                         get(/databases/$(database)/documents/users/$(userId)/backups/$(backupId)).data.userId == request.auth.uid;

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(backupId) &&
                         isValidId(chunkId) &&
                         isValidBackupChunk(incoming(), userId, backupId) &&
                         incoming().userId == existing().userId &&
                         incoming().backupId == existing().backupId &&
                         incoming().chunkIndex == existing().chunkIndex &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['payload', 'updatedAt']) &&
                         exists(/databases/$(database)/documents/users/$(userId)/backups/$(backupId)) &&
                         get(/databases/$(database)/documents/users/$(userId)/backups/$(backupId)).data.userId == request.auth.uid;

        allow delete: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(backupId) &&
                         isValidId(chunkId);
      }
    }
  }
}
